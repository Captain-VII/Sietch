{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sietch",
  "version": "0.1.2",
  "identifier": "com.captainvii.sietch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "focus": false,
        "title": "Sietch",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#11131F",
        "decorations": false
      },
      {
        "label": "wiki",
        "create": false,
        "focus": false,
        "title": "Sietch — Wiki",
        "url": "wiki.html",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#11131F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://media.awakening.wiki; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1RDk2NEVBMTJGMzRENkQKUldSdFRmTVM2bVRaNWNXVkZjVU9GNWxkNjFQYTY5N2tIeW5uVjlaRTVOVUpCTU5jN0RJei9rSnoK",
      "endpoints": ["https://github.com/Captain-VII/Sietch/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Compagnon de bureau pour Dune: Awakening",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sietch",
  "version": "0.1.0",
  "identifier": "com.captainvii.sietch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sietch",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#0D0A07"
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Sietch — Overlay",
        "url": "overlay.html",
        "width": 340,
        "height": 520,
        "minWidth": 260,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "wiki",
        "create": false,
        "title": "Sietch — Wiki",
        "url": "wiki.html",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0D0A07"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://media.awakening.wiki; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Compagnon de bureau pour Dune: Awakening",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
